{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "giftagram-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare D1 Database Binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "giftagram-db",
      "database_id": "7c67abb1-2f3d-42f4-beb3-e9bc392f8c65",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare R2 Bucket Binding (Uncomment once R2 is enabled on Cloudflare Dashboard)
  // "r2_buckets": [
  //   {
  //     "binding": "IMAGES",
  //     "bucket_name": "giftagram-images"
  //   }
  // ],

  // Public Configuration Variables (Secrets like RAZORPAY_KEY_SECRET are set via `wrangler secret put`)
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://giftagram-frontend.hydpurefumes.workers.dev,http://localhost:5173,http://localhost:3000",
    "RAZORPAY_KEY_ID": "rzp_test_placeholder"
  }
}
