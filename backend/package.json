  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.114.0"
  }
}
