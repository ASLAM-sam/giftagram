{
  "name": "giftagram-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers + D1 backend API for Giftagram Luxury Gifting & Bakery",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
